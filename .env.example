# Copy this file to .env and fill in the values.
# .env is git-ignored - never commit a bot token.

# From https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_BOT_TOKEN=

# Right-click your server (Developer Mode on) -> Copy Server ID
DISCORD_GUILD_ID=

# Optional: a second server you control, to mirror content into
MIRROR_GUILD_ID=
MIRROR_ENABLED=false

# Where the archive lives
ARCHIVER_DATA_DIR=data

# Behaviour
DOWNLOAD_ATTACHMENTS=true
CAPTURE_EDITS=true
CAPTURE_DELETES=true
BACKFILL_BATCH=100
MAX_CONCURRENT_DOWNLOADS=5
